<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <!-- Website menu items for the hospital pages -->
    <record id="menu_hospital_home" model="website.menu">
        <field name="name">Hospital</field>
        <field name="url">/hospital</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence">10</field>
        <field name="website_id" ref="website.default_website"/>
    </record>

    <record id="menu_hospital_doctors" model="website.menu">
        <field name="name">Our Doctors</field>
        <field name="url">/hospital/doctors</field>
        <field name="parent_id" ref="menu_hospital_home"/>
        <field name="sequence">10</field>
        <field name="website_id" ref="website.default_website"/>
    </record>

    <record id="menu_hospital_services" model="website.menu">
        <field name="name">Services</field>
        <field name="url">/hospital/services</field>
        <field name="parent_id" ref="menu_hospital_home"/>
        <field name="sequence">20</field>
        <field name="website_id" ref="website.default_website"/>
    </record>

    <record id="menu_hospital_contact" model="website.menu">
        <field name="name">Contact</field>
        <field name="url">/hospital/contact</field>
        <field name="parent_id" ref="menu_hospital_home"/>
        <field name="sequence">30</field>
        <field name="website_id" ref="website.default_website"/>
    </record>

    <record id="menu_patient_portal" model="website.menu">
        <field name="name">Patient Portal</field>
        <field name="url">/my</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence">50</field>
        <field name="website_id" ref="website.default_website"/>
    </record>
</odoo>
