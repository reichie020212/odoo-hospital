<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hms_appointment_type_list" model="ir.ui.view">
        <field name="name">hms.appointment.type.list</field>
        <field name="model">hms.appointment.type</field>
        <field name="arch" type="xml">
            <list string="Appointment Types">
                <field name="name"/>
                <field name="default_duration" widget="float_time"/>
            </list>
        </field>
    </record>

    <record id="view_hms_appointment_type_form" model="ir.ui.view">
        <field name="name">hms.appointment.type.form</field>
        <field name="model">hms.appointment.type</field>
        <field name="arch" type="xml">
            <form string="Appointment Type">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="default_duration" widget="float_time"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hms_appointment_type_search" model="ir.ui.view">
        <field name="name">hms.appointment.type.search</field>
        <field name="model">hms.appointment.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Archived" name="filter_inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_hms_appointment_type" model="ir.actions.act_window">
        <field name="name">Appointment Types</field>
        <field name="res_model">hms.appointment.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define an appointment type</p>
            <p>Types pre-fill the default duration when selected on an appointment.</p>
        </field>
    </record>
</odoo>
