<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Add is_medicine to the product form -->
    <record id="view_product_form_inherit_hms_pharmacy" model="ir.ui.view">
        <field name="name">product.product.form.inherit.hms_pharmacy</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group>
                    <field name="is_medicine"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Medicines action (filtered by is_medicine) -->
    <record id="action_hms_medicine" model="ir.actions.act_window">
        <field name="name">Medicines</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_medicine', '=', True)]</field>
        <field name="context">{'default_is_medicine': True, 'default_type': 'product'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register a medicine</p>
            <p>Medicines flagged here appear in the Pharmacy configuration.</p>
        </field>
    </record>

    <!-- Menu under Hospital > Configuration -->
    <menuitem id="menu_hms_medicine"
              name="Medicines"
              parent="hms_base.menu_hms_configuration"
              action="action_hms_medicine"
              sequence="30"/>
</odoo>
