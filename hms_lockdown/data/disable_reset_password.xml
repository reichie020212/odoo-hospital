<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Disable the public "Reset Password" / "Forgot password?" flow.

         When this parameter is False the link disappears from the login screen
         and /web/reset_password returns "access denied". A Settings admin can
         re-enable the flow at any time via:
             Settings > Technical > Parameters > System Parameters
         (look for the key `auth_signup.reset_password`).

         We use ir.config_parameter.set_param (an upsert) instead of a <record>
         insert because `auth_signup` ships its own copy of this key with
         value=True. Inserting a second record with the same key would violate
         the ir_config_parameter_key_uniq constraint. set_param updates the
         existing row in place. -->
    <function model="ir.config_parameter" name="set_param">
        <value>auth_signup.reset_password</value>
        <value>False</value>
    </function>
</odoo>
