<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <!-- Disable the public "Reset Password" / "Forgot password?" flow.

         When this parameter is False the link disappears from the login screen
         and /web/reset_password returns "access denied". A Settings admin can
         re-enable the flow at any time via:
             Settings > Technical > Parameters > System Parameters
         (look for the key `auth_signup.reset_password`).

         The record uses noupdate="1" so the value is set on first install and
         then left alone on subsequent module upgrades. -->
    <record id="disable_reset_password_param" model="ir.config_parameter">
        <field name="key">auth_signup.reset_password</field>
        <field name="value">False</field>
    </record>
</odoo>
