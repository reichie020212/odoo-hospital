<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Form -->
    <record id="view_hms_lab_request_form" model="ir.ui.view">
        <field name="name">hms.lab.request.form</field>
        <field name="model">hms.lab.request</field>
        <field name="arch" type="xml">
            <form string="Lab Request">
                <header>
                    <button name="action_collect" string="Sample Collected" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_process" string="Start Processing" type="object"
                            class="btn-primary" invisible="state != 'collected'"/>
                    <button name="action_done" string="Validate Results" type="object"
                            class="btn-primary" invisible="state != 'processing'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('done', 'cancelled')"/>
                    <button name="action_draft" string="Reset to Draft" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,collected,processing,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Request">
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                            <field name="consultation_id"/>
                        </group>
                        <group string="Schedule">
                            <field name="date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ordered Tests" name="ordered_tests">
                            <field name="test_type_ids" widget="many2many_tags"/>
                            <button name="action_generate_results"
                                    string="Generate Result Lines"
                                    type="object"
                                    class="btn-secondary mt-2"
                                    invisible="state in ('done', 'cancelled')"/>
                        </page>
                        <page string="Results" name="results">
                            <field name="result_ids">
                                <list editable="bottom">
                                    <field name="test_type_id"/>
                                    <field name="value"/>
                                    <field name="value_text" optional="hide"/>
                                    <field name="unit"/>
                                    <field name="normal_range_min"/>
                                    <field name="normal_range_max"/>
                                    <field name="is_abnormal" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- List -->
    <record id="view_hms_lab_request_list" model="ir.ui.view">
        <field name="name">hms.lab.request.list</field>
        <field name="model">hms.lab.request</field>
        <field name="arch" type="xml">
            <list string="Lab Requests"
                  decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'done'">
                <field name="name"/>
                <field name="date"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'collected'"
                       decoration-primary="state == 'processing'"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Search -->
    <record id="view_hms_lab_request_search" model="ir.ui.view">
        <field name="name">hms.lab.request.search</field>
        <field name="model">hms.lab.request</field>
        <field name="arch" type="xml">
            <search string="Lab Requests">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Processing" name="filter_processing" domain="[('state', '=', 'processing')]"/>
                <filter string="Done" name="filter_done" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter string="Patient" name="groupby_patient" context="{'group_by': 'patient_id'}"/>
                    <filter string="Doctor" name="groupby_doctor" context="{'group_by': 'doctor_id'}"/>
                    <filter string="Status" name="groupby_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hms_lab_request" model="ir.actions.act_window">
        <field name="name">Lab Requests</field>
        <field name="res_model">hms.lab.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a lab request</p>
            <p>Order tests from a consultation, collect samples, enter results, and validate.</p>
        </field>
    </record>
</odoo>
