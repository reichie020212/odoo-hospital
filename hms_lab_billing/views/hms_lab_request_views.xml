<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Add billing button + smart button to lab request form -->
    <record id="view_hms_lab_request_form_inherit_billing" model="ir.ui.view">
        <field name="name">hms.lab.request.form.inherit.hms_lab_billing</field>
        <field name="model">hms.lab.request</field>
        <field name="inherit_id" ref="hms_lab.view_hms_lab_request_form"/>
        <field name="arch" type="xml">
            <!-- Bill button in header -->
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_create_lab_bill"
                        string="Bill"
                        type="object"
                        class="btn-primary"
                        invisible="billing_state == 'billed' or state != 'done'"/>
            </xpath>
            <!-- Billed ribbon -->
            <xpath expr="//div[@class='oe_title']" position="before">
                <widget name="web_ribbon" title="Billed" bg_color="bg-success"
                        invisible="billing_state != 'billed'"/>
                <field name="billing_state" invisible="1"/>
                <field name="sale_order_id" invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- Add product_id to test type form -->
    <record id="view_hms_lab_test_type_form_inherit_billing" model="ir.ui.view">
        <field name="name">hms.lab.test.type.form.inherit.hms_lab_billing</field>
        <field name="model">hms.lab.test.type</field>
        <field name="inherit_id" ref="hms_lab.view_hms_lab_test_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='unit']" position="after">
                <field name="product_id"/>
            </xpath>
        </field>
    </record>
</odoo>
