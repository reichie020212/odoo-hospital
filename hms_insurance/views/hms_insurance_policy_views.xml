<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hms_insurance_policy_list" model="ir.ui.view">
        <field name="name">hms.insurance.policy.list</field>
        <field name="model">hms.insurance.policy</field>
        <field name="arch" type="xml">
            <list string="Insurance Policies">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="insurance_company_id"/>
                <field name="coverage_percentage"/>
                <field name="valid_from"/>
                <field name="valid_until"/>
            </list>
        </field>
    </record>

    <record id="view_hms_insurance_policy_form" model="ir.ui.view">
        <field name="name">hms.insurance.policy.form</field>
        <field name="model">hms.insurance.policy</field>
        <field name="arch" type="xml">
            <form string="Insurance Policy">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <group>
                        <group string="Policy">
                            <field name="name"/>
                            <field name="policy_type"/>
                            <field name="coverage_percentage"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Parties">
                            <field name="patient_id"/>
                            <field name="insurance_company_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Validity">
                            <field name="valid_from"/>
                            <field name="valid_until"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hms_insurance_policy_search" model="ir.ui.view">
        <field name="name">hms.insurance.policy.search</field>
        <field name="model">hms.insurance.policy</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="insurance_company_id"/>
                <separator/>
                <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="filter_inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Insurance Company" name="groupby_company"
                            context="{'group_by': 'insurance_company_id'}"/>
                    <filter string="Patient" name="groupby_patient"
                            context="{'group_by': 'patient_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hms_insurance_policy" model="ir.actions.act_window">
        <field name="name">Insurance Policies</field>
        <field name="res_model">hms.insurance.policy</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an insurance policy</p>
            <p>Link a patient to their insurance company with a coverage percentage.</p>
        </field>
    </record>
</odoo>
