<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hms_specialization_list" model="ir.ui.view">
        <field name="name">hms.specialization.list</field>
        <field name="model">hms.specialization</field>
        <field name="arch" type="xml">
            <list string="Specializations">
                <field name="name"/>
                <field name="code"/>
                <field name="description" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_hms_specialization_form" model="ir.ui.view">
        <field name="name">hms.specialization.form</field>
        <field name="model">hms.specialization</field>
        <field name="arch" type="xml">
            <form string="Specialization">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hms_specialization_search" model="ir.ui.view">
        <field name="name">hms.specialization.search</field>
        <field name="model">hms.specialization</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter string="Archived" name="filter_inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_hms_specialization" model="ir.actions.act_window">
        <field name="name">Specializations</field>
        <field name="res_model">hms.specialization</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a medical specialization</p>
            <p>Specializations describe the clinical focus of a doctor (e.g. Cardiology, Pediatrics).</p>
        </field>
    </record>
</odoo>
