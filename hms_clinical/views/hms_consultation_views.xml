<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Form -->
    <record id="view_hms_consultation_form" model="ir.ui.view">
        <field name="name">hms.consultation.form</field>
        <field name="model">hms.consultation</field>
        <field name="arch" type="xml">
            <form string="Consultation">
                <header>
                    <button name="action_start" string="Start" type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_done" string="Complete" type="object"
                            class="btn-primary"
                            invisible="state != 'in_progress'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('done', 'cancelled')"/>
                    <button name="action_draft" string="Reset to Draft" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Patient &amp; Doctor">
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                            <field name="appointment_id"/>
                        </group>
                        <group string="Schedule">
                            <field name="date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Clinical Notes" name="clinical_notes">
                            <group>
                                <field name="chief_complaint"
                                       placeholder="Patient's primary concern..."/>
                                <field name="history"
                                       placeholder="History of present illness..."/>
                                <field name="examination"
                                       placeholder="Physical examination findings..."/>
                                <field name="diagnosis"
                                       placeholder="Clinical diagnosis..."/>
                                <field name="treatment_plan"
                                       placeholder="Treatment plan and follow-up..."/>
                            </group>
                        </page>
                        <page string="Vitals" name="vitals">
                            <field name="vital_ids">
                                <list editable="bottom">
                                    <field name="bp_systolic"/>
                                    <field name="bp_diastolic"/>
                                    <field name="heart_rate"/>
                                    <field name="temperature"/>
                                    <field name="spo2"/>
                                    <field name="weight"/>
                                    <field name="height"/>
                                    <field name="bmi"/>
                                </list>
                            </field>
                        </page>
                        <page string="Prescription" name="prescription">
                            <field name="prescription_line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="qty"/>
                                    <field name="dosage"/>
                                    <field name="frequency"/>
                                    <field name="duration_days"/>
                                    <field name="instructions"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- List -->
    <record id="view_hms_consultation_list" model="ir.ui.view">
        <field name="name">hms.consultation.list</field>
        <field name="model">hms.consultation</field>
        <field name="arch" type="xml">
            <list string="Consultations"
                  decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'done'">
                <field name="name"/>
                <field name="date"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="diagnosis" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-primary="state == 'in_progress'"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Kanban -->
    <record id="view_hms_consultation_kanban" model="ir.ui.view">
        <field name="name">hms.consultation.kanban</field>
        <field name="model">hms.consultation</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="date"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-card">
                        <div>
                            <strong><field name="name"/></strong>
                            <div><field name="patient_id"/></div>
                            <div class="text-muted"><field name="doctor_id"/> — <field name="date"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search -->
    <record id="view_hms_consultation_search" model="ir.ui.view">
        <field name="name">hms.consultation.search</field>
        <field name="model">hms.consultation</field>
        <field name="arch" type="xml">
            <search string="Consultations">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="diagnosis"/>
                <separator/>
                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="In Progress" name="filter_in_progress"
                        domain="[('state', '=', 'in_progress')]"/>
                <filter string="Done" name="filter_done"
                        domain="[('state', '=', 'done')]"/>
                <filter string="Cancelled" name="filter_cancelled"
                        domain="[('state', '=', 'cancelled')]"/>
                <group expand="0" string="Group By">
                    <filter string="Doctor" name="groupby_doctor"
                            context="{'group_by': 'doctor_id'}"/>
                    <filter string="Patient" name="groupby_patient"
                            context="{'group_by': 'patient_id'}"/>
                    <filter string="Status" name="groupby_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Date" name="groupby_date"
                            context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hms_consultation" model="ir.actions.act_window">
        <field name="name">Consultations</field>
        <field name="res_model">hms.consultation</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a consultation</p>
            <p>Record clinical encounters, vitals, and prescriptions.</p>
        </field>
    </record>

    <!-- Patients action (res.partner filtered by is_patient) -->
    <record id="action_hms_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_patient', '=', True)]</field>
        <field name="context">{'default_is_patient': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register a patient</p>
        </field>
    </record>
</odoo>
