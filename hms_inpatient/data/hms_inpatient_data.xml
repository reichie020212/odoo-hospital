<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <!-- Room charge products -->
    <record id="product_room_standard" model="product.product">
        <field name="name">Room Charge — Standard</field>
        <field name="type">service</field>
        <field name="list_price">100.0</field>
        <field name="sale_ok" eval="True"/>
        <field name="purchase_ok" eval="False"/>
    </record>
    <record id="product_room_private" model="product.product">
        <field name="name">Room Charge — Private</field>
        <field name="type">service</field>
        <field name="list_price">250.0</field>
        <field name="sale_ok" eval="True"/>
        <field name="purchase_ok" eval="False"/>
    </record>
    <record id="product_room_icu" model="product.product">
        <field name="name">Room Charge — ICU</field>
        <field name="type">service</field>
        <field name="list_price">500.0</field>
        <field name="sale_ok" eval="True"/>
        <field name="purchase_ok" eval="False"/>
    </record>

    <!-- Sample wards -->
    <record id="ward_general" model="hms.ward">
        <field name="name">General Ward</field>
        <field name="floor">Ground Floor</field>
        <field name="gender_restriction">mixed</field>
    </record>
    <record id="ward_icu" model="hms.ward">
        <field name="name">Intensive Care Unit</field>
        <field name="floor">1st Floor</field>
        <field name="gender_restriction">mixed</field>
    </record>

    <!-- Sample beds -->
    <record id="bed_g1" model="hms.bed">
        <field name="name">G-101</field>
        <field name="ward_id" ref="ward_general"/>
        <field name="bed_type">standard</field>
        <field name="product_id" ref="product_room_standard"/>
    </record>
    <record id="bed_g2" model="hms.bed">
        <field name="name">G-102</field>
        <field name="ward_id" ref="ward_general"/>
        <field name="bed_type">standard</field>
        <field name="product_id" ref="product_room_standard"/>
    </record>
    <record id="bed_icu1" model="hms.bed">
        <field name="name">ICU-01</field>
        <field name="ward_id" ref="ward_icu"/>
        <field name="bed_type">icu</field>
        <field name="product_id" ref="product_room_icu"/>
    </record>

    <!-- Daily room-charge CRON -->
    <record id="ir_cron_daily_room_charges" model="ir.cron">
        <field name="name">HMS: Daily Room Charges</field>
        <field name="model_id" ref="model_hms_admission"/>
        <field name="state">code</field>
        <field name="code">model._cron_daily_room_charges()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
