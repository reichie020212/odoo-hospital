<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hms_bed_list" model="ir.ui.view">
        <field name="name">hms.bed.list</field>
        <field name="model">hms.bed</field>
        <field name="arch" type="xml">
            <list string="Beds"
                  decoration-success="state == 'available'"
                  decoration-danger="state == 'occupied'"
                  decoration-warning="state == 'cleaning'"
                  decoration-muted="state == 'maintenance'">
                <field name="name"/>
                <field name="ward_id"/>
                <field name="bed_type"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'available'"
                       decoration-danger="state == 'occupied'"
                       decoration-warning="state == 'cleaning'"
                       decoration-muted="state == 'maintenance'"/>
                <field name="product_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_hms_bed_form" model="ir.ui.view">
        <field name="name">hms.bed.form</field>
        <field name="model">hms.bed</field>
        <field name="arch" type="xml">
            <form string="Bed">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="ward_id"/>
                            <field name="bed_type"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="product_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hms_bed_search" model="ir.ui.view">
        <field name="name">hms.bed.search</field>
        <field name="model">hms.bed</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="ward_id"/>
                <separator/>
                <filter string="Available" name="filter_available" domain="[('state', '=', 'available')]"/>
                <filter string="Occupied" name="filter_occupied" domain="[('state', '=', 'occupied')]"/>
                <group expand="0" string="Group By">
                    <filter string="Ward" name="groupby_ward" context="{'group_by': 'ward_id'}"/>
                    <filter string="Type" name="groupby_type" context="{'group_by': 'bed_type'}"/>
                    <filter string="Status" name="groupby_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hms_bed" model="ir.actions.act_window">
        <field name="name">Beds</field>
        <field name="res_model">hms.bed</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a bed</p>
        </field>
    </record>
</odoo>
